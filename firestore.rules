rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Papel administrativo lido do próprio perfil (gravado no cadastro/admin).
    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow create: if isOwner(userId)
        && request.resource.data.role == 'user';
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow update: if (isOwner(userId)
          && request.resource.data.role == resource.data.role)
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'role', 'verified']));
      allow delete: if false;
    }

    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.type in ['text', 'image', 'video'];
      allow update: if request.auth != null
        && request.resource.data.authorId == resource.data.authorId
        && (resource.data.authorId == request.auth.uid
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount', 'sharesCount']));
      allow delete: if (request.auth != null && resource.data.authorId == request.auth.uid) || isAdmin();

      match /likes/{userId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
      }
    }

    match /users/{userId}/following/{targetId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId && targetId != userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/followers/{followerId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == followerId && followerId != userId;
      allow delete: if request.auth != null && request.auth.uid == followerId;
    }

    match /users/{userId}/saved/{postId} {
      allow read, create, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Segurança da conta (2FA/métodos): só o dono lê/escreve.
    match /users/{userId}/security/{securityDoc} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read, delete: if isOwner(userId) || isAdmin();
      allow create: if request.auth != null;
      allow update: if (isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']))
        || isAdmin();
    }

    // Stories: leitura autenticada; escrita só via backend agendado (Fase 3).
    match /stories/{storyId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    // Conversas: somente participantes leem/escrevem; admin audita (lista/leitura).
    match /conversations/{conversationId} {
      allow read: if isSignedIn()
        && (request.auth.uid in resource.data.participantIds || isAdmin());
      allow list: if isAdmin();
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participantIds;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt']);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
            || isAdmin());
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow update, delete: if false;
      }
    }

    // Newsletter pública: qualquer visitante pode inscrever um e-mail válido;
    // leitura/alteração só via backend administrativo.
    match /newsletter/{subscriptionId} {
      allow create: if request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.consent == true;
      allow read, update, delete: if false;
    }

    // Recursos de conta: qualquer pessoa pode abrir um recurso com e-mail válido;
    // leitura/decisão só via admin.
    match /appeals/{appealId} {
      allow create: if request.resource.data.email is string
        && request.resource.data.email.size() > 3;
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    // Comunidades: leitura pública; criação autenticada validada;
    // participação gerenciada pelo próprio usuário; selo/status só via admin.
    match /communities/{communityId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verified', 'status', 'featured']);
      allow delete: if false;

      match /members/{memberId} {
        allow read: if true;
        allow create, delete: if request.auth != null && request.auth.uid == memberId;
        allow update: if false;
      }
    }

    match /reports/{reportId} {
      allow create: if request.auth != null && request.resource.data.reporterId == request.auth.uid;
      allow read: if request.auth != null
        && (resource.data.reporterId == request.auth.uid || isAdmin());
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    match /scheduled_posts/{scheduleId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /consents/{consentId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && consentId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && consentId == request.auth.uid;
      allow delete: if false;
    }

    // Config global da plataforma: só admin lê/escreve,
    // exceto o mapa de módulos (leitura pública, sem segredos).
    match /platform_settings/modules {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /platform_settings/{settingsId} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    // Páginas institucionais: leitura pública; edição só admin.
    match /site_pages/{pageId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Trilha de auditoria administrativa: escrita autenticada com autor real,
    // leitura só admin.
    match /admin_audit/{auditId} {
      allow create: if isSignedIn()
        && request.resource.data.adminUid == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Memorial: solicitações do próprio usuário; decisão só via admin.
    match /memorial_requests/{requestId} {
      allow create: if isSignedIn()
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.status == 'PENDING';
      allow read: if isSignedIn()
        && (resource.data.requesterId == request.auth.uid || isAdmin());
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    // Homenagens: leitura autenticada; criação validada; remoção só do autor.
    match /tributes/{tributeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }
  }
}
