rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Papel administrativo lido do próprio perfil (gravado no cadastro/admin).
    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow create: if isOwner(userId)
        && request.resource.data.role == 'user';
      // Leitura de perfil por qualquer autenticado (nomes/avatars no feed e
      // perfis públicos); listagem segue restrita ao admin (sem enumeração).
      // E-mails permanecem nos docs: a UI nunca os exibe de terceiros.
      allow get: if isSignedIn() || isAdmin();
      allow list: if isAdmin();
      allow update: if (isOwner(userId)
          && request.resource.data.role == resource.data.role)
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'role', 'verified']));
      allow delete: if false;
    }

    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.type in ['text', 'image', 'video'];
      allow update: if request.auth != null
        && request.resource.data.authorId == resource.data.authorId
        && (resource.data.authorId == request.auth.uid
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount', 'sharesCount']));
      allow delete: if (request.auth != null && resource.data.authorId == request.auth.uid) || isAdmin();

      match /likes/{userId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
      }
    }

    match /users/{userId}/following/{targetId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId && targetId != userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/followers/{followerId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == followerId && followerId != userId;
      allow delete: if request.auth != null && request.auth.uid == followerId;
    }

    match /users/{userId}/saved/{postId} {
      allow read, create, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Bloqueios: grafo privado do próprio usuário.
    match /users/{userId}/blocks/{targetId} {
      allow read, create, delete: if isOwner(userId) && targetId != userId;
      allow update: if false;
    }

    // Segurança da conta (2FA/métodos): só o dono lê/escreve.
    match /users/{userId}/security/{securityDoc} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read, delete: if isOwner(userId) || isAdmin();
      allow create: if request.auth != null;
      allow update: if (isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']))
        || isAdmin();
    }

    // Stories: leitura autenticada; criação validada do próprio autor;
    // remoção do autor ou admin. Expiração filtrada na leitura.
    match /stories/{storyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.mediaUrl is string
        && request.resource.data.mediaUrl.size() > 0;
      allow update: if false;
      allow delete: if (request.auth != null && resource.data.authorId == request.auth.uid) || isAdmin();
    }

    // Conversas: somente participantes leem/escrevem; admin audita (lista/leitura).
    match /conversations/{conversationId} {
      allow read: if isSignedIn()
        && (request.auth.uid in resource.data.participantIds || isAdmin());
      allow list: if isAdmin();
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participantIds;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt', 'read']);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
            || isAdmin());
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow update, delete: if false;
      }
    }

    // Newsletter pública: qualquer visitante pode inscrever um e-mail válido;
    // leitura/alteração só via backend administrativo.
    match /newsletter/{subscriptionId} {
      allow create: if request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.consent == true;
      allow read, update, delete: if false;
    }

    // Recursos de conta: qualquer pessoa pode abrir um recurso com e-mail válido;
    // leitura/decisão só via admin.
    match /appeals/{appealId} {
      allow create: if request.resource.data.email is string
        && request.resource.data.email.size() > 3;
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    // Comunidades: leitura pública; criação autenticada validada;
    // participação gerenciada pelo próprio usuário; selo/status só via admin.
    match /communities/{communityId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verified', 'status', 'featured']))
        || (isSignedIn() && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'imageUrl']))
        // Contador de membros: incrementado pelos fluxos reais de join/leave
        // (memberships são a fonte autoritativa; contagem é só display).
        || (isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount']));
      allow delete: if false;

      match /members/{memberId} {
        allow read: if true;
        allow create, delete: if request.auth != null && request.auth.uid == memberId;
        allow update: if false;
      }
    }

    match /reports/{reportId} {
      allow create: if request.auth != null && request.resource.data.reporterId == request.auth.uid;
      allow read: if request.auth != null
        && (resource.data.reporterId == request.auth.uid || isAdmin());
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    match /scheduled_posts/{scheduleId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /consents/{consentId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && consentId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && consentId == request.auth.uid;
      allow delete: if false;
    }

    // Diretório público de criadores (somente campos publicados, sem PII).
    match /creator_profiles/{uid} {
      allow read: if true;
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid) || isAdmin();
    }

    // Contato (fale conosco): criação pública validada; leitura admin.
    match /contact_messages/{messageId} {
      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() > 1
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.message is string
        && request.resource.data.message.size() > 1;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Vagas públicas; candidaturas com login; triagem admin.
    match /job_posts/{jobId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /job_applications/{applicationId} {
      allow create: if isSignedIn()
        && request.resource.data.candidateId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 1
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
    match /platform_settings/modules {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /platform_settings/{settingsId} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    // Páginas institucionais: leitura pública; edição só admin.
    match /site_pages/{pageId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Eventos: leitura autenticada; criação validada; edição/cancelamento
    // do organizador ou admin; RSVP do próprio participante.
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.startsAt is string
        && request.resource.data.startsAt.size() > 0;
      allow update: if ((request.auth != null && resource.data.ownerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'location', 'online', 'startsAt', 'status'])) || isAdmin());
      allow delete: if (request.auth != null && resource.data.ownerId == request.auth.uid) || isAdmin();

      match /rsvps/{uid} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && request.auth.uid == uid;
        allow update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      }
    }

    // Trilha de auditoria administrativa: escrita autenticada com autor real,
    // leitura só admin.
    match /admin_audit/{auditId} {
      allow create: if isSignedIn()
        && request.resource.data.adminUid == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Memorial: solicitações do próprio usuário; decisão só via admin.
    match /memorial_requests/{requestId} {
      allow create: if isSignedIn()
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.status == 'PENDING';
      allow read: if isSignedIn()
        && (resource.data.requesterId == request.auth.uid || isAdmin());
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    // Homenagens: leitura autenticada; criação validada; remoção só do autor.
    match /tributes/{tributeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.memorialId is string
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }
  }
}
