rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    match /users/{uid} { allow read: if signedIn(); allow create: if self(uid); allow update: if self(uid) || admin(); allow delete: if admin(); }
    match /profiles/{uid} { allow read: if true; allow write: if self(uid) || admin(); }
    match /social_links/{id} { allow read: if resource.data.privacy == 'public' || self(resource.data.userId) || admin(); allow create: if signedIn() && request.resource.data.userId == request.auth.uid; allow update,delete: if self(resource.data.userId) || admin(); }
    match /posts/{id} { allow read: if resource.data.visibility == 'PUBLIC' && resource.data.status == 'ACTIVE' || signedIn(); allow create: if signedIn() && request.resource.data.authorId == request.auth.uid; allow update,delete: if signedIn() && resource.data.authorId == request.auth.uid || admin(); }
    match /comments/{id} { allow read: if true; allow create: if signedIn() && request.resource.data.authorId == request.auth.uid; allow update,delete: if signedIn() && resource.data.authorId == request.auth.uid || admin(); }
    match /likes/{id} { allow read: if true; allow create: if signedIn() && request.resource.data.userId == request.auth.uid; allow delete: if signedIn() && resource.data.userId == request.auth.uid; }
    match /follows/{id} { allow read: if signedIn(); allow create,delete: if signedIn() && request.resource.data.followerId == request.auth.uid; }
    match /conversations/{id} { allow read,update: if signedIn() && request.auth.uid in resource.data.participantIds; allow create: if signedIn() && request.auth.uid in request.resource.data.participantIds; }
    match /messages/{id} { allow read,create: if signedIn(); allow update: if signedIn() && resource.data.senderId == request.auth.uid; }
    match /calls/{id} { allow read,create,update: if signedIn(); }
    match /products/{id} { allow read: if resource.data.status == 'ACTIVE'; allow create,update: if signedIn() && request.resource.data.sellerId == request.auth.uid; allow delete: if admin(); }
    match /orders/{id} { allow read: if signedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || admin()); allow create: if signedIn() && request.resource.data.buyerId == request.auth.uid; allow update: if admin() || signedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid); }
    match /reports/{id} { allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid; allow read: if signedIn() && (resource.data.reporterId == request.auth.uid || admin()); allow update: if admin(); }
    match /audit_logs/{id} { allow read: if admin(); allow write: if false; }
    match /{document=**} { allow read,write: if admin(); }
  }
}
