# FLOW API — exemplo (FASE 2). Copie para backend/.env (gitignored) e preencha.
# Nunca commitar valores reais (ver backend/.gitignore).
NODE_ENV=development
PORT=8080
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
# Opcional (Guardian Vertex AI / Gemini):
# GOOGLE_APPLICATION_CREDENTIALS=
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global
# FLOW_GUARDIAN_ENABLED=false
# FLOW_GUARDIAN_MODEL=gemini-2.5-flash
# FLOW_GUARDIAN_TIMEOUT_MS=8000
# CORS: lista separada por vírgula — prod + dev local (FASE 2 exige localhost:3000).
CORS_ORIGIN=https://flow-web-mu.vercel.app,http://localhost:3000
# Web Push VAPID (gerar com: node -e "console.log(require('web-push').generateVAPIDKeys())").
# VAPID_PUBLIC=
# VAPID_PRIVATE=
# VAPID_SUBJECT=mailto:admin@flow.social
