{
  "name": "flow-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/main.js",
    "seed:marina": "npm run build && node dist/src/seed-marina.js",
    "seed:admin": "npm run build && node dist/src/seed-admin.js",
    "test": "tsx tests/domain.test.ts && tsx tests/api.test.ts",
    "vercel-build": "npm run build"
  },
  "dependencies": {
    "@google/genai": "latest",
    "@types/web-push": "^3.6.4",
    "argon2": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "express-rate-limit": "^8.7.0",
    "firebase": "latest",
    "firebase-admin": "latest",
    "helmet": "latest",
    "jsonwebtoken": "latest",
    "web-push": "^3.6.7",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/jsonwebtoken": "latest",
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
