# Firebase Web Client configuration (Client-side)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# FASE 2 — ligação frontend→backend (REGRA DE CONCLUSÃO FLOW):
# Canônica e obrigatória: URL ABSOLUTA do backend com /api/v1.
# Dev: VITE_API_BASE_URL=http://localhost:8080/api/v1 (backend `npm run dev`).
# Prod (Vercel env): URL pública do backend (NUNCA o próprio frontend flow-web-mu.vercel.app,
# cujo fallback SPA reescreveria /api para index.html e quebraria a integração).
# Depreciado (só fallback em client.ts): VITE_API_URL.
VITE_API_BASE_URL=http://localhost:8080/api/v1
# VITE_API_URL=

# Backend configuration (Server-side)
NODE_ENV=development
PORT=3001
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=




